10 REM In the Hall of the Mountain King
20 REM BBC Micro 3 voices + noise. Made by beebtune.py from mountain-king.mid
30 MODE 7
40 ON ERROR PROCquiet:REPORT:PRINT " at line ";ERL:END
50 S%=5565:REM grid step in 1/256 centiseconds. Bigger = slower
60 K%=16:G%=8:Q%=10:R%=0*S%
70 DIM T% 127,F% 127,M% 127,L% 127,N% 127,E% 127,Y% 127,V% 15,H%(G%),O%(Q%)
80 FOR I%=0 TO 127:T%?I%=64:NEXT
90 FOR I%=0 TO 15:READ C%:V%?I%=C%:NEXT
100 A$="0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz+-"
110 FOR I%=0 TO 63:C%=ASC(MID$(A$,I%+1,1)):T%?C%=I%:F%?C%=16+(I% AND 3):M%?C%=-(I%>3):L%?C%=V%?(I% DIV 4):N%?C%=I%*4:E%?C%=I% DIV 8+2:Y%?C%=I% AND 7:NEXT
120 FOR I%=0 TO Q%-1:READ O%(I%):NEXT
130 ENVELOPE 1,1,0,0,0,0,0,0,126,-6,0,-12,126,96:REM tone: sharp attack, sustain, quick release
140 ENVELOPE 2,1,0,0,0,0,0,0,126,-16,-16,-16,126,0:REM noise: short tick (kick, hi-hat)
150 ENVELOPE 3,1,0,0,0,0,0,0,126,-7,-7,-7,126,0:REM noise: medium (snare, toms)
160 ENVELOPE 4,1,0,0,0,0,0,0,126,-3,-3,-3,126,0:REM noise: long (cymbals)
170 P%=PAGE:I%=0
180 REPEAT:IF P%?1*256+P%?2>999 THEN PROCline
190 P%=P%+P%?3:UNTIL P%?1>127
200 IF I%<>G% THEN PRINT "Tune data is incomplete":END
210 PRINT '"In the Hall of the Mountain King"''"Press ESCAPE to stop"
220 PROCquiet:J%=0:Z%=TIME*256+12800:PROCnext:U%=W% DIV 256:REPEAT UNTIL TIME>=U%
230 REPEAT
240 D%=T%?(?P%):IF D%>62 THEN PROCodd:UNTIL FALSE
250 IF D% THEN W%=W%+S%*D%:U%=W% DIV 256:REPEAT UNTIL TIME>=U%
260 A%=P%?1:B%=P%?2:P%=P%+3
270 IF F%?A%=16 THEN SOUND 16,E%?B%,Y%?B%,L%?A% ELSE SOUND F%?A%,M%?A%,N%?B%,L%?A%
280 UNTIL FALSE
290 END
300 DEF PROCline
310 C%=P%+3:REPEAT C%=C%+1:UNTIL ?C%>127
320 REPEAT C%=C%+1:UNTIL ?C%<>32:H%(I%)=C%:I%=I%+1
330 ENDPROC
340 DEF PROCodd
350 IF D%=63 THEN W%=W%+S%*T%?(P%?1):P%=P%+2 ELSE PROCnext
360 U%=W% DIV 256:REPEAT UNTIL TIME>=U%
370 ENDPROC
380 DEF PROCnext
390 IF J%=Q% THEN J%=0:Z%=Z%-R%
400 P%=H%(O%(J%)):J%=J%+1:W%=Z%:Z%=Z%+K%*S%
410 ENDPROC
420 DEF PROCquiet
430 FOR I%=0 TO 3:SOUND 16+I%,0,4,1:NEXT
440 ENDPROC
500 REM Note lengths, in 1/20 second, for length codes 0 to 15
510 DATA 1,1,2,3,4,5,6,7,8,10,12,14,16,20,24,255
520 REM Play order of the blocks below
